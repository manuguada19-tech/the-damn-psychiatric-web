# ============ THE DAMN PSYCHIATRIC — configuración Apache (Hostalia) ============
Options -Indexes
DirectoryIndex index.html

# --- Forzar HTTPS (activa antes el SSL gratuito en el panel de Hostalia) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- elpsiquiatricomaldito.com → thedamnpsychiatric.es ---
  RewriteCond %{HTTP_HOST} ^(www\.)?elpsiquiatricomaldito\.com$ [NC]
  RewriteRule ^(.*)$ https://thedamnpsychiatric.es/$1 [R=301,L]

  # --- www del dominio principal → sin www ---
  RewriteCond %{HTTP_HOST} ^www\.thedamnpsychiatric\.es$ [NC]
  RewriteRule ^(.*)$ https://thedamnpsychiatric.es/$1 [R=301,L]
</IfModule>

# --- Compresión ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# --- Caché ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
